#=============================================================================
# sdram.qsf -- EP4CE10F17C8 + W9825G6KH-6 引脚约束
# 抄录自用户原理图截图(2026-10-18),已逐脚核对.
# 2026-10-18 补:SDRAM_CS=K10 / SDRAM_D0=P14 / SDRAM_D6=L11(BANK4), 39 根信号已齐.
# IO 电平:SDRAM 为 3.3V 供电,全部用 3.3-V LVTTL;
#      原理图 POWER 页确认:VCCIO1~VCCIO8 全部接 3.3V(VCC_IO 经 R9=0Ω 接 VCC3.3),
#      BANK4/5/6/7 的 VCCIO=3.3V 无误.
#=============================================================================

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE10F17C8
set_global_assignment -name TOP_LEVEL_ENTITY sdram_top

set_global_assignment -name SDC_FILE sdram.sdc
set_global_assignment -name VERILOG_FILE rtl/sdram_top.v
set_global_assignment -name VERILOG_FILE rtl/sdram_ctrl.v
set_global_assignment -name VERILOG_FILE rtl/sdram_selftest.v
set_global_assignment -name VERILOG_FILE rtl/sdram_pll.v
set_global_assignment -name VERILOG_FILE rtl/uart_send.v
set_global_assignment -name VERILOG_FILE rtl/sdram_uart_monitor.v

set_global_assignment -name RESERVE_ALL_UNUSED_PINS_WEAK_PULLUP "AS INPUT TRI-STATED WITH WEAK PULL-UP"
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

#---------------- BANK5: 数据低字节/控制 ----------------
set_location_assignment PIN_M12 -to sdram_dq[1]
set_location_assignment PIN_L12 -to sdram_dq[3]
set_location_assignment PIN_K12 -to sdram_dq[7]
set_location_assignment PIN_N14 -to sdram_dq[2]
set_location_assignment PIN_K11 -to sdram_ras_n
set_location_assignment PIN_L14 -to sdram_dq[5]
set_location_assignment PIN_L13 -to sdram_dq[4]
set_location_assignment PIN_L16 -to sdram_dq[14]
set_location_assignment PIN_L15 -to sdram_dq[15]
set_location_assignment PIN_J11 -to sdram_dq[9]
set_location_assignment PIN_K16 -to sdram_dq[12]
set_location_assignment PIN_K15 -to sdram_dq[13]
set_location_assignment PIN_J16 -to sdram_dq[10]
set_location_assignment PIN_J15 -to sdram_dq[11]
set_location_assignment PIN_J14 -to sdram_dqm[0]
set_location_assignment PIN_J12 -to sdram_cas_n
set_location_assignment PIN_J13 -to sdram_we_n

#---------------- BANK6: 数据高字节/DQM1/地址高位/控制 ----------------
set_location_assignment PIN_G16 -to sdram_dq[8]
set_location_assignment PIN_G15 -to sdram_dqm[1]
set_location_assignment PIN_F13 -to sdram_ba[1]
set_location_assignment PIN_F16 -to sdram_cke
set_location_assignment PIN_F15 -to sdram_a[12]
set_location_assignment PIN_B16 -to sdram_a[6]
set_location_assignment PIN_F14 -to sdram_a[10]
set_location_assignment PIN_D16 -to sdram_a[11]
set_location_assignment PIN_D15 -to sdram_a[9]
set_location_assignment PIN_G11 -to sdram_ba[0]
set_location_assignment PIN_C16 -to sdram_a[8]
set_location_assignment PIN_C15 -to sdram_a[7]

#---------------- BANK7: 地址低位/时钟 ----------------
set_location_assignment PIN_C14 -to sdram_a[3]
set_location_assignment PIN_D14 -to sdram_a[2]
set_location_assignment PIN_A14 -to sdram_a[4]
set_location_assignment PIN_B14 -to sdram_clk
set_location_assignment PIN_E11 -to sdram_a[1]
set_location_assignment PIN_F11 -to sdram_a[0]
set_location_assignment PIN_A15 -to sdram_a[5]

#---------------- BANK4: 片选 + 数据位 0/6 ----------------
set_location_assignment PIN_K10 -to sdram_cs_n
set_location_assignment PIN_P14 -to sdram_dq[0]
set_location_assignment PIN_L11 -to sdram_dq[6]

#---------------- 时钟/复位/LED:正点原子 E10(原理图 E10_________V1.1) ----------------
set_location_assignment PIN_E1 -to clk_50m
set_location_assignment PIN_M1 -to rst_n
set_location_assignment PIN_A4 -to led_init_done
set_location_assignment PIN_B5 -to led_err
set_location_assignment PIN_A13 -to uart_txd

#---------------- IO 标准 ----------------
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_dq[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_a[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_ba[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_dqm[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cke
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_ras_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cas_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_we_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to sdram_cs_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50m
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_init_done
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_err
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to uart_txd
